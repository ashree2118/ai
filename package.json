{
  "name": "token-lab",
  "version": "1.0.0",
  "description": "Anthropic SDK tools: token counting and multi-turn conversations",
  "type": "module",
  "bin": {
    "token-lab": "./dist/index.js",
    "chat": "./dist/chat.js",
    "stream": "./dist/stream.js",
    "prompt-compare": "./dist/prompt-compare.js",
    "agent": "./dist/agent.js",
    "embedding-lab": "./dist/embedding-lab.js",
    "chunk-lab": "./dist/chunk-lab.js",
    "rag-cli": "./dist/rag-cli.js",
    "eval-cli": "./dist/eval-cli.js",
    "react-agent": "./dist/react-agent-cli.js",
    "context-agent": "./dist/context-agent-cli.js",
    "e2e-cli": "./dist/e2e-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "count": "node dist/index.js count",
    "compare": "node dist/index.js compare",
    "chat": "node dist/chat.js",
    "stream": "node dist/stream.js",
    "prompt-compare": "node dist/prompt-compare.js",
    "agent": "node dist/agent.js",
    "embedding-lab": "node dist/embedding-lab.js",
    "chunk-lab": "node dist/chunk-lab.js",
    "rag-cli": "node dist/rag-cli.js",
    "eval-cli": "node dist/eval-cli.js",
    "react-agent": "node dist/react-agent-cli.js",
    "context-agent": "node dist/context-agent-cli.js",
    "e2e": "node dist/e2e-cli.js",
    "test": "npm run build && node --test dist/tools.test.js dist/tool-loop.test.js dist/github/toolkit.test.js dist/tool-registry.test.js dist/embeddings/math.test.js dist/chunker/chunker.test.js dist/rag/store.test.js dist/eval/metrics.test.js dist/react-agent.test.js dist/context/builder.test.js dist/guardrails.test.js dist/e2e/analyze.test.js dist/memory/scratchpad.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@octokit/rest": "^22.0.0",
    "pg": "^8.16.0",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.2"
  }
}
